# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose environment — infrastructure only.
#
# This file configures Docker/Compose itself. It is NOT the application
# environment: Laravel reads its own configuration from backend/.env, and
# nothing here belongs there.
#
# Copy to .env at the repository root only when you need to override a default:
#   cp .env.example .env
# Every value below already has a working default baked into docker-compose.yml,
# so the stack runs correctly with no .env file present.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Image naming ───
# Three distinct concepts, never interchangeable:
#   build          — the Dockerfile and context an image is produced from
#   image          — the name:tag that build is published under, and that the
#                    container is created from
#   container_name — the fixed runtime name of the running instance
#
# Only the images this project builds itself are configurable here. Third-party
# images (postgres, redis, adminer) are pinned upstream in docker-compose.yml.
#
#   Service     Image                     Container
#   backend     alphamaster/backend       alphamaster-backend
#   horizon     alphamaster/horizon       alphamaster-horizon
#   scheduler   alphamaster/scheduler     alphamaster-scheduler
#   nginx       alphamaster/nginx         alphamaster-nginx
#
# Namespace applied to every image this project builds.
ALPHAMASTER_IMAGE_NAMESPACE=alphamaster

# Tag applied to every image this project builds. Set to a release or commit
# SHA to build and run a specific version instead of the rolling local build.
ALPHAMASTER_IMAGE_TAG=latest

# ─── Database provisioning ───
# Consumed by the postgres service to provision the cluster on first start.
# Container names and volumes are fixed in docker-compose.yml and are not
# configurable here. These must match DB_* in backend/.env, which is what the
# application actually connects with. Leave unset to accept the defaults
# declared in docker-compose.yml; never commit real credentials.
# DB_DATABASE=alphamaster
# DB_USERNAME=alphamaster
# DB_PASSWORD=
